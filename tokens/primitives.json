{
  "$description": "Dakit primitives: raw values, no opinions about usage. Names are ramps and scales only — nothing here may be referenced by application code; apps consume the semantic layer. Leaf values become --dk-<key.path> (e.g. gray.200 -> --dk-gray-200).",

  "gray": {
    "$type": "color",
    "0": { "$value": "#ffffff" },
    "50": { "$value": "#f6f8fa" },
    "100": { "$value": "#eef1f4" },
    "200": { "$value": "#d0d7de" },
    "300": { "$value": "#afb8c1" },
    "400": { "$value": "#8c959f" },
    "500": { "$value": "#6e7681" },
    "600": { "$value": "#57606a" },
    "700": { "$value": "#424a53" },
    "800": { "$value": "#32383f" },
    "900": { "$value": "#24292f" },
    "950": { "$value": "#0f172a" }
  },

  "blue": {
    "$type": "color",
    "50": { "$value": "#edf5ff" },
    "300": { "$value": "#79b8ff" },
    "400": { "$value": "#58a6ff" },
    "500": { "$value": "#315f8f" },
    "600": { "$value": "#244d78" },
    "700": { "$value": "#1c3d5e" },
    "900": { "$value": "#10233c" }
  },

  "green": {
    "$type": "color",
    "50": { "$value": "#e1e9dd" },
    "300": { "$value": "#aac3ae" },
    "400": { "$value": "#49b981" },
    "500": { "$value": "#60b98a" },
    "600": { "$value": "#0b6745" },
    "700": { "$value": "#074e33" }
  },

  "amber": {
    "$type": "color",
    "100": { "$value": "#fff8c5" },
    "400": { "$value": "#d4a72c" },
    "500": { "$value": "#9a6700" },
    "600": { "$value": "#7a5c00" }
  },

  "red": {
    "$type": "color",
    "50": { "$value": "#fff0ee" },
    "300": { "$value": "#cda37f" },
    "500": { "$value": "#cf222e" },
    "600": { "$value": "#9c4b20" },
    "700": { "$value": "#a40e26" }
  },

  "font": {
    "$type": "fontFamily",
    "sans": { "$value": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif" },
    "mono": { "$value": "'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace" }
  },

  "text": {
    "$type": "dimension",
    "xs": { "$value": "11px" },
    "sm": { "$value": "12px" },
    "md": { "$value": "13px" },
    "body": { "$value": "14px" },
    "lg": { "$value": "16px" },
    "xl": { "$value": "22px" },
    "page": { "$value": "32px" }
  },

  "leading": {
    "$type": "number",
    "tight": { "$value": "1.2" },
    "normal": { "$value": "1.5" }
  },

  "weight": {
    "$type": "fontWeight",
    "regular": { "$value": "400" },
    "medium": { "$value": "500" },
    "semibold": { "$value": "600" },
    "bold": { "$value": "700" }
  },

  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "20px" },
    "6": { "$value": "24px" },
    "7": { "$value": "32px" },
    "8": { "$value": "40px" }
  },

  "radius": {
    "$type": "dimension",
    "none": { "$value": "0" },
    "sm": { "$value": "4px" },
    "md": { "$value": "6px" },
    "lg": { "$value": "10px" },
    "full": { "$value": "999px" }
  },

  "size": {
    "$type": "dimension",
    "control-sm": { "$value": "28px" },
    "control-md": { "$value": "34px" },
    "control-lg": { "$value": "40px" },
    "touch": { "$value": "44px" },
    "sidebar": { "$value": "268px" },
    "content-max": { "$value": "1120px" }
  }
}
