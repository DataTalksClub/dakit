{
  "$description": "Dakit semantic layer, light theme (the default). Roles only: components and apps may use these, never the primitive ramps. Values may alias primitives with '{ramp.step}' references. Every text/background pair used together is contrast-checked at build time (see tokens/contrast.json).",

  "light": {
    "bg": {
      "$type": "color",
      "page": { "$value": "{gray.0}" },
      "surface": { "$value": "{gray.0}" },
      "muted": { "$value": "{gray.50}" },
      "hover": { "$value": "{gray.100}" },
      "raised": { "$value": "{gray.0}" },
      "inset": { "$value": "rgba(36, 41, 47, 0.06)" },
      "backdrop": { "$value": "rgba(15, 23, 42, 0.4)" }
    },

    "text": {
      "$type": "color",
      "primary": { "$value": "{gray.900}" },
      "heading": { "$value": "{gray.950}" },
      "muted": { "$value": "{gray.600}" },
      "faint": { "$value": "{gray.500}" },
      "link": { "$value": "{blue.500}" },
      "link-hover": { "$value": "{blue.600}" },
      "on-accent": { "$value": "#ffffff" },
      "on-deep": { "$value": "#ffffff" }
    },

    "border": {
      "$type": "color",
      "default": { "$value": "{gray.200}" },
      "control-hover": { "$value": "{gray.200}" },
      "strong": { "$value": "{gray.300}" }
    },

    "accent": {
      "$type": "color",
      "default": { "$value": "{blue.500}" },
      "hover": { "$value": "{blue.600}" },
      "soft": { "$value": "{blue.50}" },
      "deep": { "$value": "{blue.600}" },
      "deep-hover": { "$value": "{blue.600}" },
      "deeper": { "$value": "{blue.700}" }
    },

    "focus": {
      "$type": "color",
      "ring": { "$value": "rgba(49, 95, 143, 0.6)" }
    },

    "selection": {
      "$type": "color",
      "$value": "#dde9f7"
    },

    "success": {
      "$type": "color",
      "text": { "$value": "#116329" },
      "bg": { "$value": "#e6f6ea" }
    },

    "warning": {
      "$type": "color",
      "text": { "$value": "{amber.600}" },
      "bg": { "$value": "{amber.100}" }
    },

    "danger": {
      "$type": "color",
      "text": { "$value": "{red.500}" },
      "hover": { "$value": "{red.700}" },
      "bg": { "$value": "{red.50}" }
    },

    "info": {
      "$type": "color",
      "text": { "$value": "{blue.500}" },
      "bg": { "$value": "{blue.50}" }
    },

    "shadow": {
      "$type": "shadow",
      "overlay": { "$value": "0 8px 24px rgba(15, 23, 42, 0.16)" }
    },

    "gap": {
      "$type": "dimension",
      "$description": "Layout rhythm by role, so apps stop inventing 6/10/14px gaps. control: between adjacent interactive controls (also the row gap when a group wraps). block: between a block (table, panel, empty state, form) and the controls before or after it. section: between page sections.",
      "control": { "$value": "{space.3}" },
      "block": { "$value": "{space.4}" },
      "section": { "$value": "{space.6}" }
    },

    "pad": {
      "$type": "dimension",
      "$description": "Inner padding by role. cell: table cells and divided rows. panel: inside a bordered panel or card.",
      "cell": { "$value": "{space.2} {space.3}" },
      "panel": { "$value": "{space.4}" }
    }
  }
}
