{
  "$comment": "Dakit semantic layer, light theme (the default). Roles only: components and apps may use these, never the primitive ramps. Values may alias primitives with '{ramp.step}' references. Every text/background pair used together is contrast-checked at build time (see tokens/contrast.json).",

  "light": {
    "bg": {
      "page": "{gray.0}",
      "surface": "{gray.0}",
      "muted": "{gray.50}",
      "hover": "{gray.100}",
      "raised": "{gray.0}",
      "inset": "rgba(36, 41, 47, 0.06)",
      "backdrop": "rgba(15, 23, 42, 0.5)"
    },

    "text": {
      "primary": "{gray.900}",
      "heading": "{gray.950}",
      "muted": "{gray.600}",
      "faint": "{gray.500}",
      "link": "{blue.500}",
      "link-hover": "{blue.600}",
      "on-accent": "#ffffff",
      "on-deep": "#ffffff"
    },

    "border": {
      "default": "{gray.200}",
      "control-hover": "{gray.200}",
      "strong": "{gray.300}"
    },

    "accent": {
      "default": "{blue.500}",
      "hover": "{blue.600}",
      "soft": "{blue.50}",
      "border": "rgba(49, 95, 143, 0.4)",
      "deep": "{blue.600}",
      "deep-hover": "{blue.600}",
      "deeper": "{blue.700}"
    },

    "focus": {
      "ring": "rgba(49, 95, 143, 0.6)"
    },

    "selection": "#dde9f7",

    "success": {
      "text": "#116329",
      "bg": "#e6f6ea",
      "border": "#b7dfc2"
    },

    "warning": {
      "text": "{amber.600}",
      "bg": "{amber.100}",
      "border": "{amber.400}"
    },

    "danger": {
      "text": "{red.500}",
      "hover": "{red.700}",
      "bg": "{red.50}",
      "border": "rgba(207, 34, 46, 0.24)"
    },

    "info": {
      "text": "{blue.500}",
      "bg": "{blue.50}",
      "border": "rgba(49, 95, 143, 0.22)"
    },

    "shadow": {
      "overlay": "0 8px 24px rgba(15, 23, 42, 0.16)"
    },

    "gap": {
      "$comment": "Layout rhythm by role, so apps stop inventing 6/10/14px gaps. control: between adjacent interactive controls (also the row gap when a group wraps). block: between a block (table, panel, empty state, form) and the controls before or after it. section: between page sections.",
      "control": "{space.3}",
      "block": "{space.4}",
      "section": "{space.6}"
    },

    "pad": {
      "$comment": "Inner padding by role. cell: table cells and divided rows. panel: inside a bordered panel or card.",
      "cell": "{space.2} {space.3}",
      "panel": "{space.4}"
    }
  }
}
