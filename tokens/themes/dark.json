{
  "$comment": "Dakit dark theme: overrides only. Every key here must exist in semantic.json's light theme (the build enforces this). Applied via :root[data-theme=\"dark\"] — see docs/tokens.md for the boot script that falls back to the OS preference.",

  "bg": {
    "page": "#0d1117",
    "surface": "#161b22",
    "muted": "#21262d",
    "hover": "#293038",
    "raised": "{gray.800}",
    "inset": "rgba(230, 237, 243, 0.07)",
    "backdrop": "rgba(1, 4, 9, 0.7)"
  },

  "text": {
    "primary": "#e6edf3",
    "heading": "#f0f6fc",
    "muted": "#9198a1",
    "faint": "#8b949e",
    "link": "{blue.400}",
    "link-hover": "{blue.300}",
    "on-accent": "#0d1117",
    "on-deep": "#ffffff"
  },

  "border": {
    "default": "#30363d",
    "strong": "#6e7681"
  },

  "accent": {
    "default": "{blue.400}",
    "hover": "{blue.300}",
    "soft": "rgba(88, 166, 255, 0.14)",
    "border": "rgba(88, 166, 255, 0.4)",
    "deep": "{blue.700}",
    "deep-hover": "{blue.600}",
    "deeper": "{blue.900}"
  },

  "focus": {
    "ring": "rgba(88, 166, 255, 0.55)"
  },

  "selection": "rgba(88, 166, 255, 0.35)",

  "success": {
    "text": "#56d364",
    "bg": "rgba(46, 160, 67, 0.15)",
    "border": "rgba(46, 160, 67, 0.45)"
  },

  "warning": {
    "text": "#e3b341",
    "bg": "rgba(187, 128, 9, 0.15)",
    "border": "rgba(187, 128, 9, 0.45)"
  },

  "danger": {
    "text": "#f85149",
    "hover": "#ffa198",
    "bg": "rgba(248, 81, 73, 0.12)",
    "border": "rgba(248, 81, 73, 0.45)"
  },

  "info": {
    "text": "{blue.300}",
    "bg": "rgba(88, 166, 255, 0.12)",
    "border": "rgba(88, 166, 255, 0.4)"
  },

  "shadow": {
    "card": "0 1px 2px rgba(1, 4, 9, 0.4)",
    "overlay": "0 8px 24px rgba(1, 4, 9, 0.6)"
  }
}
